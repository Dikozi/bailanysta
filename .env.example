# ── База данных ───────────────────────────────────────────────
# Прод: строка подключения Neon (пулер), например
#   postgresql://user:pass@ep-xxx-pooler.eu-central-1.aws.neon.tech/bailanysta?sslmode=require
# Локально: `npx prisma dev --name bailanysta` напечатает готовую строку.
DATABASE_URL=""

# Нужен только для локальных `prisma migrate dev`. В проде не требуется.
SHADOW_DATABASE_URL=""

# ── Авторизация ───────────────────────────────────────────────
# Секрет подписи JWT. Сгенерировать: openssl rand -base64 48
JWT_SECRET=""

# ── AI-ассистент (необязательно) ──────────────────────────────
# Ключ с console.anthropic.com. Если пусто — AI-эндпоинты честно
# отвечают 503 AI_NOT_CONFIGURED, остальное приложение работает.
ANTHROPIC_API_KEY=""
